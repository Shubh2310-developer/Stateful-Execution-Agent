{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Trace",
  "type": "object",
  "properties": {
    "trace_id": { "type": "string" },
    "task_id": { "type": "string" },
    "event_type": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "context": { "type": "object" }
  },
  "required": ["trace_id", "task_id", "event_type", "timestamp", "context"]
}
