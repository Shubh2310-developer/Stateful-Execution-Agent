{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TaskState",
  "type": "object",
  "properties": {
    "task_id": { "type": "string" },
    "user_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["pending", "planning", "planned", "in_progress", "paused", "completed", "failed"]
    },
    "goal": { "type": "object" },
    "plan": { "$ref": "#/definitions/plan" },
    "current_step_index": { "type": "integer" },
    "artifacts": { "type": "object" },
    "decisions": { "type": "array" }
  },
  "required": ["task_id", "user_id", "status", "goal"],
  "definitions": {
    "plan": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string" },
        "goal_summary": { "type": "string" },
        "steps": { "type": "array" }
      }
    }
  }
}
